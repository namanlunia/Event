# OWOC Environment Variables

# Demo Mode Configuration
# Defaults to TRUE (sample preview data shown with "Sample" labels) until real program data exists.
# Set to 'false' only when the program is live and real data is flowing from the database.
# Omit this variable or set it to anything other than 'false' to keep demo mode on.
NEXT_PUBLIC_DEMO_MODE=true

# Organization & Contact Details
NEXT_PUBLIC_ORG_NAME="Omnikon"
NEXT_PUBLIC_CONTACT_EMAIL="contact@omnikon.org"
NEXT_PUBLIC_CONDUCT_EMAIL="conduct@omnikon.org"

# Social Links (Leave empty to omit icons from footer and header)
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# Supabase Credentials (Optional for local mockup, required for live DB storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# GitHub OAuth & Webhooks
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
